# --- AgentRouter / LLM provider (REQUIRED for translation) ---
# Get your API key from your AgentRouter account. NEVER commit the real key.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Any model available to your AgentRouter account, e.g.:
#   glm-5.3 (best translation quality; reasoning model)
#   deepseek-v4-flash (faster/cheaper)
#   claude-opus-5, gpt-5.6-sol
AGENTROUTER_MODEL=glm-5.3
# AgentRouter's WAF requires a sanctioned coding-agent client wire image on the
# OpenAI-compatible endpoint; these Codex CLI defaults are verified to work.
AGENTROUTER_CLIENT_UA="codex_cli_rs/0.21.0 (Windows 11; x86_64) unknown"
AGENTROUTER_ORIGINATOR=codex_cli_rs
# Completion token cap per chunk (reasoning models need headroom; escalates
# automatically on retry when the model exhausts it).
AGENTROUTER_MAX_TOKENS=16384
# Reasoning effort for reasoning-capable models (e.g. glm-5.3).
# "low" = fast/cheap/reliable for translation (recommended). "medium"/"high"
# = slower and can exhaust the token cap. Empty = omit the parameter.
AGENTROUTER_REASONING_EFFORT=low

# --- ALTERNATIVE PROVIDER: Google Gemini (free, no card, works from servers) ---
# AgentRouter blocks datacenter IPs (cloud hosts) with its WAF. For cloud
# deployments, Google Gemini's OpenAI-compatible endpoint works from ANY IP
# and has a generous free tier (no credit card). Get a key at
# https://aistudio.google.com/apikey then set:
#   AGENTROUTER_API_KEY=<your Gemini key>
#   AGENTROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AGENTROUTER_MODEL=gemini-2.5-flash
# The provider auto-detects Gemini endpoints (drops the WAF wire headers and
# reasoning_effort automatically).

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO

# Optional site-wide password: when set, every visitor must enter it
# (browser password prompt, any username) before using the app. Protects
# your API credits from strangers who find the public link. Empty = open.
APP_ACCESS_PASSWORD=

# --- Limits ---
MAX_FILE_SIZE_MB=100
MAX_CONCURRENT_TRANSLATIONS=2
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
CHUNK_TARGET_CHARS=4000
CHUNK_MAX_CHARS=6000
CONTEXT_CHARS=1500
REQUEST_TIMEOUT_SECONDS=180

# --- OCR (local) ---
# Optional full path to tesseract.exe if not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Housekeeping ---
TEMP_CLEANUP_HOURS=24

# --- Remote worker mode (cloud deployments) ---
# AgentRouter's WAF blocks chat-completions calls from datacenter IPs
# (cloud hosts get an HTML challenge page instead of JSON). When
# WORKER_MODE=true the server manages jobs but relays the LLM calls to a
# trusted machine (home IP) running scripts/cloud_worker.py.
# Set BOTH of these on the cloud deployment; run the worker on your machine.
WORKER_MODE=false
WORKER_API_KEY=
