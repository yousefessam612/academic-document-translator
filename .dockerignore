# Never bake secrets or local state into the image
.env
.env.local
**/.env

# Git
.git
.gitignore

# Python
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
backend/data/*
!backend/data/.gitkeep

# Node
**/node_modules
frontend/dist

# Storage (runtime data)
storage/uploads/*
storage/temp/*
storage/outputs/*
storage/processed/*
!storage/*/.gitkeep

# Local dev artifacts
*.log
logs
docs
README.md
render.yaml
